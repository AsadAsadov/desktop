# Flask server
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe
ADMIN_EMAIL=admin@example.com
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-this-password'))"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$replace_with_generated_hash
DATABASE_PATH=monitor.db
UPLOAD_FOLDER=screens
SCREENSHOT_KEEP_MINUTES=5
MAX_UPLOAD_MB=8
SESSION_COOKIE_SECURE=true
ONLINE_SECONDS=15
PORT=5000

# Client / managed PC agent
SERVER_URL=https://your-server.example.com
DEVICE_TOKEN=paste-admin-generated-token-here
DEVICE_NAME=FINANCE-PC-01
INTERVAL=0.5
PREVIEW_MAX_WIDTH=1280
JPEG_QUALITY=68
